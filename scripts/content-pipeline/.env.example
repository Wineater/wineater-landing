# Copy to scripts/content-pipeline/.env (git-ignored). Never commit real keys.

# Required for content:plan and content:draft (Google Gemini API key, e.g. the one in wineater-backend/.env)
GEMINI_API_KEY=
# Flash-lite class: clustering, plan, research (Google Search grounding), claim extraction
CONTENT_MODEL_PLAN=gemini-3.1-flash-lite
# Strongest text model available to the key: article drafting and the QA fix pass
CONTENT_MODEL_DRAFT=gemini-3.1-pro-preview

# Hard stops for one run. Tokens always apply; USD only works when prices below are set.
CONTENT_MAX_USD_PER_RUN=3
CONTENT_MAX_TOKENS_PER_RUN=600000
# Cost estimate only (data/content/runs.jsonl). Fill from the current Gemini pricing page, USD per million tokens.
# Left empty on purpose: empty means cost is reported as 0 and only tokens are tracked.
CONTENT_PRICE_PLAN_IN_PER_MTOK=
CONTENT_PRICE_PLAN_OUT_PER_MTOK=
CONTENT_PRICE_DRAFT_IN_PER_MTOK=
CONTENT_PRICE_DRAFT_OUT_PER_MTOK=
# Per grounded search query, if the pricing page bills it
CONTENT_PRICE_PER_SEARCH=

# Optional: search volume, keyword difficulty (DataForSEO)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: People Also Ask, related searches, and the source fallback for research (SerpAPI)
SERPAPI_KEY=

# Optional: queries the site already gets (Google Search Console, service account JSON)
GSC_CREDENTIALS_PATH=
GSC_SITE_URL=sc-domain:wineater.com
