# Copy to scripts/content-pipeline/.env (git-ignored). Never commit real keys.

# Required for content:plan and content:draft (Google Gemini API key, e.g. the one in wineater-backend/.env)
GEMINI_API_KEY=
# Models (defaults shown). Plan, grounded research and claim extraction use the fast model.
CONTENT_MODEL_PLAN=gemini-3.8-flash
CONTENT_MODEL_RESEARCH=gemini-3.8-flash
# Drafting and the QA fix pass use the strongest model; if it errors (not found, quota, 5xx after retries)
# the call is repeated on the fallback model and the run log marks it (fallbackUsed).
CONTENT_MODEL_DRAFT=gemini-3.1-pro-preview
CONTENT_MODEL_DRAFT_FALLBACK=gemini-3.8-flash

# Hard stops for one run (USD uses the built-in price table; tokens always apply).
CONTENT_MAX_USD_PER_RUN=3
CONTENT_MAX_TOKENS_PER_RUN=600000
# Prices are built in (lib/runs.ts, USD per million tokens, checked 2026-09-30; 3.8 Flash switches to its
# 1 January 2027 price automatically; grounding: 5,000 free searches a month, then 0.014 USD each).
# Override or add a model with JSON, e.g.:
# CONTENT_PRICES_JSON={"gemini-3.8-flash":{"in":0.75,"out":3.75},"my-model":{"in":1,"out":4}}
CONTENT_PRICES_JSON=

# Optional: search volume, keyword difficulty (DataForSEO)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: People Also Ask, related searches, and the source fallback for research (SerpAPI)
SERPAPI_KEY=

# Optional: queries the site already gets (Google Search Console, service account JSON)
GSC_CREDENTIALS_PATH=
GSC_SITE_URL=sc-domain:wineater.com
